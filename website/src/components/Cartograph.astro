---
/**
 * Lightweight cartographic composition inspired by Bari's waterfront layout.
 * Illustrative geometry—not a live tile render or a product screenshot.
 */
---

<figure class="cartograph relative overflow-hidden border border-rule bg-land">
  <svg
    class="block h-auto w-full"
    viewBox="0 0 640 720"
    role="img"
    aria-label="Stylized cartographic composition centred on Bari’s waterfront"
  >
    <defs>
      <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="#315C49" stroke-width="1" opacity="0.18"></line>
      </pattern>
    </defs>

    <rect width="640" height="720" fill="#E8E4D8"></rect>

    <!-- Geographic grid -->
    <g stroke="#C9C5B8" stroke-width="1" opacity="0.9">
      {Array.from({ length: 13 }).map((_, i) => (
        <line x1={40 + i * 48} y1="40" x2={40 + i * 48} y2="680"></line>
      ))}
      {Array.from({ length: 14 }).map((_, i) => (
        <line x1="40" y1={40 + i * 48} x2="600" y2={40 + i * 48}></line>
      ))}
    </g>

    <!-- Water -->
    <path
      d="M40 430 C120 390 180 470 260 440 S400 360 480 400 S560 470 600 450 L600 680 L40 680 Z"
      fill="#B7C9C0"
    ></path>
    <path
      d="M40 470 C140 440 220 510 310 480 S470 410 560 455 L560 680 L40 680 Z"
      fill="url(#hatch)"
      opacity="0.55"
    ></path>

    <!-- Park -->
    <path
      d="M360 120 C430 150 470 220 450 290 C420 370 330 390 280 340 C240 300 250 230 290 180 C320 145 335 125 360 120 Z"
      fill="#C7D4B8"
    ></path>

    <!-- Roads -->
    <g fill="none" stroke="#F7F5EF" stroke-width="14" stroke-linecap="round">
      <path d="M80 160 H560"></path>
      <path d="M100 260 H540"></path>
      <path d="M70 360 H570"></path>
      <path d="M160 80 V520"></path>
      <path d="M300 60 V600"></path>
      <path d="M450 90 V540"></path>
    </g>
    <g fill="none" stroke="#FFFDF8" stroke-width="6" stroke-linecap="round">
      <path d="M80 160 H560"></path>
      <path d="M100 260 H540"></path>
      <path d="M70 360 H570"></path>
      <path d="M160 80 V520"></path>
      <path d="M300 60 V600"></path>
      <path d="M450 90 V540"></path>
    </g>

    <!-- Building footprints -->
    <g fill="#D9D3C5" stroke="#B8B2A3" stroke-width="1">
      <rect x="180" y="180" width="48" height="36"></rect>
      <rect x="320" y="200" width="56" height="42"></rect>
      <rect x="200" y="280" width="64" height="48"></rect>
      <rect x="340" y="300" width="44" height="38"></rect>
      <rect x="470" y="220" width="52" height="40"></rect>
      <rect x="180" y="380" width="70" height="50"></rect>
    </g>

    <!-- Route -->
    <path
      class="route-path"
      d="M150 520 C220 420 280 340 340 250"
      fill="none"
      stroke="#315C49"
      stroke-width="8"
      stroke-linecap="round"
    ></path>
    <path
      class="route-path"
      d="M150 520 C220 420 280 340 340 250"
      fill="none"
      stroke="#E56B35"
      stroke-width="4"
      stroke-linecap="round"
    ></path>

    <!-- Origin / destination -->
    <circle cx="150" cy="520" r="9" fill="#315C49" stroke="#FFFDF8" stroke-width="3"></circle>
    <circle cx="340" cy="250" r="9" fill="#E56B35" stroke="#FFFDF8" stroke-width="3"></circle>

    <!-- Scale bar -->
    <g transform="translate(72 628)">
      <rect x="0" y="0" width="96" height="8" fill="#202521"></rect>
      <rect x="0" y="0" width="48" height="8" fill="#FFFDF8" stroke="#202521"></rect>
      <text x="0" y="28" fill="#5C6B63" font-size="12" font-family="IBM Plex Mono, monospace">0</text>
      <text x="82" y="28" fill="#5C6B63" font-size="12" font-family="IBM Plex Mono, monospace">500 m</text>
    </g>

    <!-- Grid refs -->
    <text x="48" y="32" fill="#5C6B63" font-size="11" font-family="IBM Plex Mono, monospace">N 41.13</text>
    <text x="520" y="32" fill="#5C6B63" font-size="11" font-family="IBM Plex Mono, monospace">E 16.87</text>
    <text x="48" y="700" fill="#5C6B63" font-size="11" font-family="IBM Plex Mono, monospace">sheet · illustrative</text>
  </svg>

  <figcaption class="mono border-t border-rule bg-sheet px-4 py-3 text-xs text-muted">
    Cartographic study · Bari waterfront · not a live map tile
  </figcaption>
</figure>

<style>
  .route-path {
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: draw 1.8s ease forwards 0.2s;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
