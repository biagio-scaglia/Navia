---
/** Illustrative Bari waterfront composition — not a live tile render. */
---

<figure class="overflow-hidden rounded-[1rem] border border-line bg-land shadow-[0_16px_40px_rgba(15,27,45,0.08)]">
  <svg class="block h-auto w-full" viewBox="0 0 640 560" role="img" aria-label="Stylized map of Bari’s waterfront">
    <rect width="640" height="560" fill="#E4ECF6"></rect>
    <g stroke="#D5DEEA" stroke-width="1">
      {Array.from({ length: 12 }).map((_, i) => <line x1={20 + i * 52} y1="20" x2={20 + i * 52} y2="540"></line>)}
      {Array.from({ length: 10 }).map((_, i) => <line x1="20" y1={20 + i * 52} x2="620" y2={20 + i * 52}></line>)}
    </g>
    <path d="M20 330 C120 290 190 380 280 345 S430 275 520 320 S600 370 620 350 L620 540 L20 540 Z" fill="#B9D0EA"></path>
    <path d="M360 90 C430 120 470 190 450 250 C420 330 330 350 280 300 C240 260 250 200 290 150 C320 115 335 95 360 90 Z" fill="#C9DFC4"></path>
    <g fill="none" stroke="#FFFFFF" stroke-width="12" stroke-linecap="round">
      <path d="M70 140 H560"></path>
      <path d="M90 230 H540"></path>
      <path d="M60 310 H570"></path>
      <path d="M150 60 V420"></path>
      <path d="M290 40 V480"></path>
      <path d="M440 70 V430"></path>
    </g>
    <g fill="#D7DEE8">
      <rect x="170" y="150" width="44" height="32" rx="2"></rect>
      <rect x="310" y="170" width="52" height="38" rx="2"></rect>
      <rect x="190" y="250" width="60" height="44" rx="2"></rect>
      <rect x="330" y="270" width="40" height="34" rx="2"></rect>
    </g>
    <path class="route" d="M140 420 C210 330 270 260 330 180" fill="none" stroke="#0B4FB8" stroke-width="8" stroke-linecap="round"></path>
    <path class="route" d="M140 420 C210 330 270 260 330 180" fill="none" stroke="#1677FF" stroke-width="4" stroke-linecap="round"></path>
    <circle cx="140" cy="420" r="9" fill="#00BFA6" stroke="#fff" stroke-width="3"></circle>
    <circle cx="330" cy="180" r="9" fill="#E5483B" stroke="#fff" stroke-width="3"></circle>
    <circle cx="220" cy="320" r="8" fill="#1677FF" stroke="#fff" stroke-width="3"></circle>
  </svg>
  <figcaption class="flex items-center justify-between gap-3 border-t border-line bg-surface px-4 py-3 text-xs text-muted">
    <span>Bari · illustrative map</span>
    <span class="mono">41.13° N · 16.87° E</span>
  </figcaption>
</figure>

<style>
  .route {
    stroke-dasharray: 480;
    stroke-dashoffset: 480;
    animation: draw 1.6s ease forwards 0.25s;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .route {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
