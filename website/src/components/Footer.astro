---
import { mediaCredits, nav, site } from '../data/site'
const base = import.meta.env.BASE_URL
---

<footer class="colophon">
  <div class="wrap colophon-grid">
    <div>
      <a href={base} class="brand brand-light">
        <img src={`${base}navia_logo.svg`} alt="" width="30" height="30" loading="lazy" />
        <span>{site.name}</span>
      </a>
      <p class="colophon-note">
        Navigatore open source per Android, nato a Bari. Versione {site.version}, licenza {site.license}.
      </p>
    </div>

    <nav aria-label="Pagine">
      <h2>Il sito</h2>
      <ul>
        {nav.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
        <li><a href={`${base}privacy/`}>Informativa sulla privacy</a></li>
      </ul>
    </nav>

    <nav aria-label="Progetto">
      <h2>Il progetto</h2>
      <ul>
        <li><a href={site.github} rel="noopener" target="_blank">Codice sorgente</a></li>
        <li><a href={site.releases} rel="noopener" target="_blank">Release</a></li>
        <li><a href={site.contributing} rel="noopener" target="_blank">Come contribuire</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap colophon-legal">
    <p>
      © {site.year} {site.author}. Dati della mappa ©
      <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">contributori di OpenStreetMap</a> (ODbL).
    </p>
    <p>
      Foto e video mostrano Bari e la Puglia, non schermate dell’app:
      {mediaCredits.map((c, i) => (
        <>
          <a href={c.page} rel="noopener" target="_blank">{c.title}</a> di {c.creator} ({c.licence}){i < mediaCredits.length - 1 ? '; ' : '.'}
        </>
      ))}
    </p>
  </div>
</footer>
