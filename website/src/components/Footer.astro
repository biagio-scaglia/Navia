---
import Icon from './Icon.astro'
import { site } from '../data/site'
const base = import.meta.env.BASE_URL
---

<footer class="border-t border-line bg-surface">
  <div class="measure grid gap-10 py-12 md:grid-cols-[1.4fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <img src={`${base}navia_logo.svg`} alt="" width="28" height="28" />
        <span class="font-display text-lg font-bold">{site.name}</span>
      </div>
      <p class="mt-3 max-w-md text-sm text-muted">
        Open-source navigation for Android. Code under {site.license}; map data © OpenStreetMap contributors (ODbL).
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <a class="flex items-center gap-2 text-sm font-semibold no-underline hover:text-brand-deep" href={site.github} rel="noreferrer" target="_blank">
        <Icon name="github" size={18} /> Repository
      </a>
      <a class="flex items-center gap-2 text-sm font-semibold no-underline hover:text-brand-deep" href={`${base}privacy/`}>
        <Icon name="shield" size={18} /> Privacy
      </a>
      <a class="flex items-center gap-2 text-sm font-semibold no-underline hover:text-brand-deep" href={site.contributing} rel="noreferrer" target="_blank">
        <Icon name="code" size={18} /> Contributing
      </a>
      <a class="flex items-center gap-2 text-sm font-semibold no-underline hover:text-brand-deep" href={`${base}#documentation`}>
        <Icon name="document" size={18} /> Documentation
      </a>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="measure flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:justify-between">
      <p class="mono">{site.copyright} · v{site.version}</p>
      <p>Map data © OpenStreetMap contributors</p>
    </div>
  </div>
</footer>
