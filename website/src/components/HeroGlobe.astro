---
/**
 * Globo WebGL (cobe): nessuna richiesta di rete, la mappa della Terra è nel pacchetto.
 * Parte da ovest, si ferma su Bari e da lì oscilla piano; si può trascinare.
 */
---

<div class="globe" data-globe-wrap>
  <canvas data-globe aria-hidden="true"></canvas>
</div>
<!-- Dopo il globo: l'ancora di Bari deve precedere l'etichetta nel DOM -->
<span class="globe-pin" aria-hidden="true"></span>
<p class="globe-label" aria-hidden="true">
  <strong>Bari</strong>
  <span>da qui parte Navia</span>
</p>

<script>
  import createGlobe from 'cobe'

  const BARI: [number, number] = [41.1258, 16.8667]
  // Lontane abbastanza da non ammassarsi su Bari a questo zoom
  const CITIES: [number, number][] = [
    [51.5074, -0.1278], // Londra
    [48.8566, 2.3522], // Parigi
    [52.52, 13.405], // Berlino
    [40.4168, -3.7038], // Madrid
    [41.0082, 28.9784], // Istanbul
    [30.0444, 31.2357], // Il Cairo
  ]

  const wrap = document.querySelector<HTMLElement>('[data-globe-wrap]')
  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]')

  if (wrap && canvas) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    const targetPhi = Math.PI - ((BARI[1] * Math.PI) / 180 - Math.PI / 2)
    const targetTheta = ((BARI[0] * Math.PI) / 180) * 0.85

    let size = canvas.offsetWidth
    let phi = still ? targetPhi : targetPhi - 2.4
    let drag = 0
    let dragFrom: number | null = null
    let visible = true
    let frame = 0
    const start = performance.now()

    try {
      const globe = createGlobe(canvas, {
        devicePixelRatio: dpr,
        width: size * dpr,
        height: size * dpr,
        phi,
        theta: targetTheta,
        dark: 1,
        diffuse: 1.4,
        mapSamples: 22000,
        mapBrightness: 5.5,
        mapBaseBrightness: 0.02,
        baseColor: [0.16, 0.28, 0.52],
        markerColor: [0, 0.75, 0.65],
        glowColor: [0.05, 0.3, 0.75],
        markers: [
          { location: BARI, size: 0.025, color: [0.9, 0.28, 0.23], id: 'bari' },
          ...CITIES.map((location) => ({ location, size: 0.018 })),
        ],
        arcs: CITIES.map((to) => ({ from: BARI, to })),
        arcColor: [0.42, 0.66, 1],
        arcWidth: 0.45,
        arcHeight: 0.3,
        markerElevation: 0.01,
      })

      const tick = (now: number) => {
        const t = (now - start) / 1000
        if (!still) {
          // 2,6 s di avvicinamento, poi un'oscillazione lenta intorno a Bari
          const intro = Math.min(t / 2.6, 1)
          const ease = 1 - Math.pow(1 - intro, 4)
          phi = targetPhi - 2.4 * (1 - ease) + Math.sin(Math.max(t - 2.6, 0) * 0.18) * 0.35 * ease
        }
        if (dragFrom === null) drag *= 0.94
        globe.update({ phi: phi + drag, theta: targetTheta, width: size * dpr, height: size * dpr })
        frame = visible ? requestAnimationFrame(tick) : 0
      }

      new ResizeObserver(() => (size = canvas.offsetWidth)).observe(canvas)
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting
        if (visible && !frame) frame = requestAnimationFrame(tick)
      }).observe(canvas)

      canvas.addEventListener('pointerdown', (e) => {
        dragFrom = e.clientX - drag * 220
        canvas.setPointerCapture(e.pointerId)
        wrap.classList.add('is-dragging')
      })
      canvas.addEventListener('pointermove', (e) => {
        if (dragFrom !== null) drag = (e.clientX - dragFrom) / 220
      })
      const release = () => {
        dragFrom = null
        wrap.classList.remove('is-dragging')
      }
      canvas.addEventListener('pointerup', release)
      canvas.addEventListener('pointercancel', release)

      frame = requestAnimationFrame(tick)
      requestAnimationFrame(() => wrap.classList.add('is-ready'))
    } catch {
      wrap.classList.add('no-webgl')
    }
  }
</script>
