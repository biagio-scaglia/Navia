---
/**
 * Globo WebGL (cobe): nessuna richiesta di rete, la mappa della Terra è nel pacchetto.
 * Da Bari partono percorsi a puntini che scorrono, come il tracciato del logo.
 * Si carica dopo la pagina e adatta qualità e fotogrammi al dispositivo.
 */
---

<div class="globe" data-globe-wrap>
  <canvas data-globe aria-hidden="true"></canvas>
  <span class="globe-pin" aria-hidden="true" data-globe-pin></span>
  <p class="globe-label" aria-hidden="true" data-globe-label>
    <strong>Bari</strong>
    <span>da qui parte Navia</span>
  </p>
</div>

<script>
  type LatLon = [number, number]

  const BARI: LatLon = [41.1258, 16.8667]
  const CITIES: LatLon[] = [
    [51.5074, -0.1278], // Londra
    [48.8566, 2.3522], // Parigi
    [52.52, 13.405], // Berlino
    [40.4168, -3.7038], // Madrid
    [41.0082, 28.9784], // Istanbul
    [30.0444, 31.2357], // Il Cairo
    [59.3293, 18.0686], // Stoccolma
  ]
  const DOTS = 7 // puntini per percorso
  const ELEVATION = 0.006
  const RAD = Math.PI / 180

  const wrap = document.querySelector<HTMLElement>('[data-globe-wrap]')
  const canvas = document.querySelector<HTMLCanvasElement>('[data-globe]')
  const pin = document.querySelector<HTMLElement>('[data-globe-pin]')
  const label = document.querySelector<HTMLElement>('[data-globe-label]')

  // Punto a frazione f del cerchio massimo tra a e b
  const toVec = ([lat, lon]: LatLon) => [
    Math.cos(lat * RAD) * Math.cos(lon * RAD),
    Math.cos(lat * RAD) * Math.sin(lon * RAD),
    Math.sin(lat * RAD),
  ]
  const routes = CITIES.map((city) => {
    const a = toVec(BARI)
    const b = toVec(city)
    const omega = Math.acos(Math.min(1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]))
    return (f: number): LatLon => {
      const s = Math.sin(omega)
      const ka = Math.sin((1 - f) * omega) / s
      const kb = Math.sin(f * omega) / s
      const [x, y, z] = [0, 1, 2].map((i) => ka * a[i] + kb * b[i])
      return [Math.atan2(z, Math.hypot(x, y)) / RAD, Math.atan2(y, x) / RAD]
    }
  })

  // Stessa proiezione di cobe (raggio 0,8, canvas quadrato): posizione 0–1 sul canvas e se il punto è davanti
  const project = ([lat, lon]: LatLon, phi: number, theta: number) => {
    const r = lat * RAD
    const a = lon * RAD - Math.PI
    const k = 0.8 + ELEVATION
    const t = [-Math.cos(r) * Math.cos(a) * k, Math.sin(r) * k, Math.cos(r) * Math.sin(a) * k]
    const [cp, sp, ct, st] = [Math.cos(phi), Math.sin(phi), Math.cos(theta), Math.sin(theta)]
    const c = cp * t[0] + sp * t[2]
    const s = sp * st * t[0] + ct * t[1] - cp * st * t[2]
    const depth = -sp * ct * t[0] + st * t[1] + cp * ct * t[2]
    return { x: (c + 1) / 2, y: (1 - s) / 2, front: depth >= 0 }
  }

  const start = async () => {
    if (!wrap || !canvas) return
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } }
    if (nav.connection?.saveData) return wrap.classList.add('no-webgl')

    const low = (nav.hardwareConcurrency ?? 8) <= 4 || (nav.deviceMemory ?? 8) <= 4
    const small = matchMedia('(max-width: 759px)').matches
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const dpr = Math.min(window.devicePixelRatio || 1, low ? 1.25 : small ? 1.5 : 2)
    const frameGap = low ? 1000 / 30 : 0

    const { default: createGlobe } = await import('cobe')

    const targetPhi = Math.PI - (BARI[1] * RAD - Math.PI / 2)
    const targetTheta = BARI[0] * RAD * 0.85
    // La misura arriva dal ResizeObserver dopo l'impaginazione: leggere offsetWidth qui la forzerebbe
    let size = 0
    size = await new Promise<number>((resolve) => {
      new ResizeObserver(([entry]) => {
        size = entry.contentRect.width
        resolve(size)
      }).observe(canvas)
    })
    let dragX = 0
    let dragY = 0
    let velX = 0
    let pointer: { x: number; y: number } | null = null
    let visible = true
    let frame = 0
    let last = 0
    let behind: boolean | null = null
    const t0 = performance.now()

    const markersAt = (t: number) => {
      // I percorsi crescono durante l'apertura, poi i puntini scorrono verso l'esterno
      const grow = still ? 1 : Math.min(Math.max((t - 1.6) / 1.4, 0), 1)
      const flow = still ? 0 : (t * 0.06) % (1 / DOTS)
      const dots = routes.flatMap((route) =>
        Array.from({ length: DOTS }, (_, i) => (i + 0.5) / DOTS + flow)
          .filter((f) => f < grow)
          .map((f) => ({ location: route(f), size: 0.011 + 0.008 * f })),
      )
      return [
        { location: BARI, size: 0.03, color: [0.9, 0.28, 0.23] as [number, number, number] },
        ...CITIES.map((location) => ({ location, size: 0.026 * grow })),
        ...dots,
      ]
    }

    // cobe riscrive a ogni fotogramma un <style> con variabili su :root, anche senza etichette:
    // costringe a ricalcolare lo stile di tutta la pagina. Lo stacchiamo dal documento e
    // posizioniamo l'etichetta di Bari da soli.
    const stylesBefore = new Set(document.head.querySelectorAll('style'))
    let globe: ReturnType<typeof createGlobe>
    try {
      globe = createGlobe(canvas, {
        devicePixelRatio: dpr,
        width: size * dpr,
        height: size * dpr,
        phi: still ? targetPhi : targetPhi - 2.4,
        theta: targetTheta,
        dark: 1,
        diffuse: 1.6,
        mapSamples: low ? 9000 : small ? 14000 : 22000,
        mapBrightness: 5.5,
        mapBaseBrightness: 0.03,
        baseColor: [0.16, 0.28, 0.52],
        markerColor: [0.42, 0.85, 0.95],
        glowColor: [0.06, 0.32, 0.8],
        markers: markersAt(still ? 10 : 0),
        markerElevation: ELEVATION,
      })
    } catch {
      return wrap.classList.add('no-webgl')
    }
    document.head.querySelectorAll('style').forEach((s) => stylesBefore.has(s) || s.remove())

    const placeLabel = (phi: number, theta: number) => {
      if (!pin || !label) return
      const p = project(BARI, phi, theta)
      const move = `translate3d(${(p.x * size).toFixed(1)}px, ${(p.y * size).toFixed(1)}px, 0)`
      pin.style.transform = move
      label.style.transform = move
      if (behind !== !p.front) {
        behind = !p.front
        wrap.classList.toggle('is-behind', behind)
      }
    }

    const tick = (now: number) => {
      frame = visible ? requestAnimationFrame(tick) : 0
      if (frameGap && now - last < frameGap) return
      last = now
      const t = (now - t0) / 1000

      let phi = targetPhi
      if (!still) {
        // 2,6 s di avvicinamento, poi un'oscillazione lenta intorno a Bari
        const ease = 1 - Math.pow(1 - Math.min(t / 2.6, 1), 4)
        phi = targetPhi - 2.4 * (1 - ease) + Math.sin(Math.max(t - 2.6, 0) * 0.18) * 0.3 * ease
      }
      if (!pointer) {
        dragX += velX
        velX *= 0.92
        dragX *= 0.965
        dragY *= 0.9
      }
      globe.update({
        phi: phi + dragX,
        theta: targetTheta + dragY,
        width: size * dpr,
        height: size * dpr,
        markers: markersAt(t),
      })
      placeLabel(phi + dragX, targetTheta + dragY)
    }

    const resume = () => {
      if (visible && !frame) frame = requestAnimationFrame(tick)
    }
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && !document.hidden
      resume()
    }).observe(canvas)
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden
      resume()
    })

    canvas.addEventListener('pointerdown', (e) => {
      pointer = { x: e.clientX, y: e.clientY }
      velX = 0
      canvas.setPointerCapture(e.pointerId)
      wrap.classList.add('is-dragging')
    })
    canvas.addEventListener('pointermove', (e) => {
      if (!pointer) return
      const dx = (e.clientX - pointer.x) / 240
      dragX += dx
      velX = dx
      dragY = Math.max(-0.45, Math.min(0.45, dragY + (e.clientY - pointer.y) / 320))
      pointer = { x: e.clientX, y: e.clientY }
    })
    const release = () => {
      pointer = null
      wrap.classList.remove('is-dragging')
    }
    canvas.addEventListener('pointerup', release)
    canvas.addEventListener('pointercancel', release)

    frame = requestAnimationFrame(tick)
    requestAnimationFrame(() => wrap.classList.add('is-ready'))
  }

  // Creare il contesto WebGL e compilare gli shader blocca il thread principale per un attimo.
  // Fino ad allora si vede la sfera a puntini in CSS. Su desktop il globo parte quando il browser
  // è libero; su telefoni e dispositivi deboli al primo tocco o scorrimento, o dopo 3 s di quiete,
  // così la pagina risponde subito.
  const idle = (cb: () => void, timeout: number) =>
    'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout }) : setTimeout(cb, 300)
  const nav = navigator as Navigator & { deviceMemory?: number }
  const light = matchMedia('(max-width: 959px)').matches || (nav.hardwareConcurrency ?? 8) <= 4 || (nav.deviceMemory ?? 8) <= 4
  let begun = false
  const begin = () => {
    if (begun) return
    begun = true
    idle(start, 1500)
  }
  const afterLoad = (cb: () => void) =>
    document.readyState === 'complete' ? cb() : addEventListener('load', cb, { once: true })

  if (light) {
    for (const type of ['pointerdown', 'touchstart', 'keydown', 'wheel', 'scroll']) {
      addEventListener(type, begin, { once: true, passive: true })
    }
    afterLoad(() => setTimeout(begin, 3000))
  } else {
    afterLoad(begin)
  }
</script>
