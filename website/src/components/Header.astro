---
import Icon from './Icon.astro'
import { nav, site } from '../data/site'
const base = import.meta.env.BASE_URL
---

<header class="masthead">
  <div class="wrap masthead-row">
    <a href={base} class="brand" aria-label="Navia, pagina iniziale">
      <img src={`${base}navia_logo.svg`} alt="" width="34" height="34" />
      <span>{site.name}</span>
    </a>

    <nav aria-label="Principale" class="masthead-nav">
      <ul>
        {nav.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn-dark btn-small" href={site.github} rel="noopener" target="_blank">
      <Icon name="github" size={18} />
      <span>GitHub</span>
    </a>
  </div>
</header>
