---
import Icon from './Icon.astro'
---

<div class="overflow-hidden rounded-[1rem] border border-line bg-surface shadow-[0_16px_40px_rgba(15,27,45,0.08)]" data-ui>
  <div class="grid lg:grid-cols-[1.15fr_0.85fr]">
    <div class="relative min-h-[22rem] overflow-hidden border-b border-line bg-land lg:min-h-[28rem] lg:border-b-0 lg:border-r">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 420 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="420" height="520" fill="#E4ECF6"></rect>
        <path d="M0 300 C90 260 150 350 220 320 S340 250 420 290 L420 520 L0 520 Z" fill="#B9D0EA"></path>
        <g fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round">
          <path d="M30 110 H390"></path>
          <path d="M40 200 H380"></path>
          <path d="M20 280 H400"></path>
          <path d="M120 40 V440"></path>
          <path d="M220 20 V480"></path>
        </g>
        <path d="M90 400 C150 310 200 250 250 170" fill="none" stroke="#1677FF" stroke-width="5" stroke-linecap="round"></path>
        <circle cx="90" cy="400" r="7" fill="#00BFA6" stroke="#fff" stroke-width="2"></circle>
        <circle cx="250" cy="170" r="7" fill="#E5483B" stroke="#fff" stroke-width="2"></circle>
        <circle cx="160" cy="310" r="8" fill="#1677FF" stroke="#fff" stroke-width="2"></circle>
      </svg>
      <div class="absolute left-4 top-4 rounded-xl border border-line bg-surface/95 px-3 py-2 text-xs font-semibold text-muted">
        © OpenStreetMap
      </div>
      <div class="absolute right-4 top-4 flex max-w-[13rem] items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2 text-sm text-muted">
        <Icon name="search" size={16} />
        <span class="truncate">Cerca un luogo…</span>
      </div>
    </div>

    <div class="flex flex-col justify-between p-6 sm:p-8">
      <div>
        <p class="mono text-xs font-medium tracking-wide text-muted uppercase">App UI · Italian · v0.8</p>
        <div class="mt-5 grid grid-cols-3 gap-2 text-center text-sm font-semibold">
          <span class="flex items-center justify-center gap-1 rounded-xl bg-tint px-2 py-2.5 text-brand-deep">
            <Icon name="directions" size={16} /> Vai
          </span>
          <span class="flex items-center justify-center gap-1 rounded-xl border border-line px-2 py-2.5 text-muted">
            <Icon name="globe" size={16} /> Scopri
          </span>
          <span class="flex items-center justify-center gap-1 rounded-xl border border-line px-2 py-2.5 text-muted">
            <Icon name="locate" size={16} /> 15 min
          </span>
        </div>
        <h3 class="mt-6 font-display text-3xl font-bold tracking-tight">Dove vuoi andare?</h3>
        <ul class="mt-5 space-y-3">
          <li class="flex items-center gap-3 rounded-xl border border-line bg-bg px-4 py-3 text-sm font-semibold">
            <span class="h-2.5 w-2.5 rounded-full bg-aqua"></span>
            La tua posizione
          </li>
          <li class="flex items-center gap-3 rounded-xl border border-line bg-bg px-4 py-3 text-sm font-semibold">
            <span class="h-2.5 w-2.5 rounded-full bg-destination"></span>
            Destinazione sulla mappa
          </li>
        </ul>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-2 rounded-xl bg-brand-deep px-4 py-2.5 text-sm font-bold text-white">
            <Icon name="route" size={16} /> Avvia
          </span>
          <span class="inline-flex items-center gap-2 rounded-xl border border-line px-4 py-2.5 text-sm font-bold">
            <Icon name="directions" size={16} /> Indicazioni
          </span>
        </div>
      </div>
      <p class="mt-8 border-t border-line pt-5 text-sm text-muted">
        Composition from shipped UI strings—not a store screenshot.
      </p>
    </div>
  </div>
</div>
