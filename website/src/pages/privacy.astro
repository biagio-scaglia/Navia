---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { privacyMeta, privacySections, privacySummary } from '../data/privacy'
import { site } from '../data/site'

const base = import.meta.env.BASE_URL
const home = new URL(base, Astro.site).href
const page = new URL(`${base}privacy/`, Astro.site).href

const schema = [
  {
    '@type': 'WebPage',
    '@id': page,
    url: page,
    name: `${privacyMeta.title} di Navia`,
    inLanguage: 'it-IT',
    dateModified: privacyMeta.lastUpdatedIso,
    isPartOf: { '@id': `${home}#sito` },
    about: { '@id': `${home}#app` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Navia', item: home },
      { '@type': 'ListItem', position: 2, name: privacyMeta.title, item: page },
    ],
  },
]
---

<BaseLayout
  title="Informativa sulla privacy – Navia, navigatore senza tracciamento"
  description="Come l’app Navia per Android tratta i tuoi dati: nessun account, nessun tracciamento, posizione solo su richiesta. Ecco quali servizi OpenStreetMap ricevono cosa."
  path="/privacy/"
  schema={schema}
>
  <article>
    <header class="night profile-head">
      <div class="wrap">
        <nav aria-label="Percorso" class="crumbs">
          <a href={base}>Navia</a> <span aria-hidden="true">/</span> <span aria-current="page">Privacy</span>
        </nav>
        <h1 class="fuel-title">{privacyMeta.title}</h1>
        <p class="lead">
          Aggiornata il <time datetime={privacyMeta.lastUpdatedIso}>{privacyMeta.lastUpdated}</time>.
          Vale per {privacyMeta.appliesTo}.
        </p>
        <p class="notice">{privacyMeta.draftNotice}</p>
      </div>
    </header>

    <div class="wrap policy-grid policy">

      <nav class="toc" aria-labelledby="indice">
        <h2 id="indice">In questa pagina</h2>
        <ol>
          <li><a href="#in-breve">In breve</a></li>
          {privacySections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ol>
      </nav>

      <div class="policy-body">
        <section id="in-breve" aria-labelledby="in-breve-titolo" class="policy-summary">
          <h2 id="in-breve-titolo">In breve</h2>
          <ul>
            {privacySummary.map((item) => <li><Icon name="check" size={20} /><span>{item}</span></li>)}
          </ul>
        </section>

        {
          privacySections.map((s) => (
            <section id={s.id} aria-labelledby={`${s.id}-titolo`}>
              <h2 id={`${s.id}-titolo`}>{s.title}</h2>
              {s.paragraphs.map((p) => <p>{p}</p>)}
            </section>
          ))
        }

        <p class="policy-links">
          <a href={base}>Torna a Navia</a>
          <a href={site.privacyMd} rel="noopener" target="_blank">
            <Icon name="external_link" size={16} /> Testo sorgente su GitHub
          </a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
