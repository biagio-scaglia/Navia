---
import BaseLayout from '../layouts/BaseLayout.astro'
import Cartograph from '../components/Cartograph.astro'
import Icon from '../components/Icon.astro'
import InterfaceStudy from '../components/InterfaceStudy.astro'
import {
  docs,
  features,
  limitations,
  privacyPoints,
  site,
  stack,
} from '../data/site'

const base = import.meta.env.BASE_URL
---

<BaseLayout>
  <!-- Hero — product-first, like Organic Maps: clear promise + visual -->
  <section class="section border-b border-line" id="overview" aria-labelledby="hero-title">
    <div class="measure grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-sm font-semibold text-muted">
          <Icon name="shield" size={16} class="text-brand-deep" />
          {site.status} · v{site.version}
        </div>
        <p class="font-display text-5xl font-bold tracking-tight sm:text-6xl">{site.name}</p>
        <h1 id="hero-title" class="mt-4 max-w-[18ch] font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          {site.headline}
        </h1>
        <p class="mt-5 max-w-[42ch] text-lg text-muted">{site.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={site.github} rel="noreferrer" target="_blank">
            <Icon name="github" size={18} />
            View on GitHub
          </a>
          <a class="btn btn-secondary" href={`${base}privacy/`}>
            <Icon name="shield" size={18} />
            Privacy policy
          </a>
        </div>
        <p class="mono mt-6 text-xs text-muted">
          {site.coordinates.label} · {site.coordinates.lat} · {site.coordinates.lon}
        </p>
        <p class="mt-2 max-w-[40ch] text-sm text-muted">
          No public APK yet—build from source with Flutter, or watch the repository for releases.
        </p>
      </div>
      <Cartograph />
    </div>
  </section>

  <!-- Privacy promise — Organic Maps style checklist -->
  <section class="section border-b border-line bg-surface" id="privacy-promise" aria-labelledby="privacy-title">
    <div class="measure">
      <div class="mb-8 max-w-2xl">
        <h2 id="privacy-title" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Built to leave you alone
        </h2>
        <p class="mt-3 text-lg text-muted">
          Same idea as privacy-first map apps you already trust: the product should work without harvesting you.
        </p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          privacyPoints.map((item) => (
            <li class="privacy-item">
              <span class="icon-badge">
                <Icon name={item.icon} size={20} />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold">{item.title}</h3>
                <p class="mt-1 text-sm text-muted">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Features with icons -->
  <section class="section border-b border-line" id="features" aria-labelledby="features-title">
    <div class="measure grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 id="features-title" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          What you get in {site.version}
        </h2>
        <p class="mt-3 text-lg text-muted">
          Only features that already ship. Roadmap items stay on the roadmap.
        </p>
        <div class="mt-8 rounded-[1rem] border border-line bg-tint p-5">
          <h3 class="flex items-center gap-2 font-display text-lg font-bold">
            <Icon name="cloud_off" size={20} class="text-brand-deep" />
            Honest limits
          </h3>
          <ul class="mt-3 space-y-2">
            {
              limitations.map((item) => (
                <li class="flex gap-2 text-sm text-muted">
                  <Icon name="close" size={16} class="mt-0.5 shrink-0 text-destination" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <ul>
        {
          features.map((feature) => (
            <li class="feature-row">
              <span class="icon-badge">
                <Icon name={feature.icon} size={20} />
              </span>
              <div>
                <h3 class="font-display text-xl font-bold">{feature.title}</h3>
                <p class="mt-1 text-muted">{feature.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Product UI -->
  <section class="section border-b border-line bg-surface" aria-labelledby="showcase-title">
    <div class="measure">
      <div class="mb-8 max-w-2xl">
        <h2 id="showcase-title" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Inside the app
        </h2>
        <p class="mt-3 text-lg text-muted">
          No store screenshots in the repo yet. This panel mirrors the real Italian UI: explore tabs, route sheet, attribution.
        </p>
      </div>
      <InterfaceStudy />
    </div>
  </section>

  <!-- Open source -->
  <section class="section border-b border-line" id="open-source" aria-labelledby="oss-title">
    <div class="measure grid gap-10 lg:grid-cols-2">
      <div>
        <h2 id="oss-title" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Open source, readable code
        </h2>
        <p class="mt-3 text-lg text-muted">
          MIT license. Flutter + MapLibre. Endpoints via <span class="mono text-sm">--dart-define</span>—no secrets in the APK.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={site.github} rel="noreferrer" target="_blank">
            <Icon name="github" size={18} /> Repository
          </a>
          <a class="btn btn-secondary" href={site.contributing} rel="noreferrer" target="_blank">
            <Icon name="code" size={18} /> Contributing
          </a>
        </div>
      </div>
      <div class="overflow-hidden rounded-[1rem] border border-line bg-surface">
        <div class="flex items-center gap-2 border-b border-line px-4 py-3 text-sm font-semibold text-muted">
          <Icon name="layers" size={18} />
          Stack
        </div>
        <table class="w-full text-left text-sm">
          <tbody>
            {
              stack.map((row) => (
                <tr class="border-b border-line last:border-0">
                  <th class="w-28 px-4 py-3 align-top font-semibold text-muted" scope="row">
                    {row.area}
                  </th>
                  <td class="px-4 py-3">{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Docs -->
  <section class="section" id="documentation" aria-labelledby="docs-title">
    <div class="measure">
      <h2 id="docs-title" class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Documentation
      </h2>
      <p class="mt-3 max-w-2xl text-lg text-muted">
        The docs live next to the code on GitHub.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          docs.map((doc) => (
            <li>
              <a
                class="privacy-item h-full no-underline transition-colors hover:border-brand"
                href={doc.href}
                rel="noreferrer"
                target="_blank"
              >
                <span class="icon-badge">
                  <Icon name={doc.icon} size={20} />
                </span>
                <div>
                  <h3 class="flex items-center gap-2 font-display text-lg font-bold">
                    {doc.title}
                    <Icon name="external_link" size={16} class="text-muted" />
                  </h3>
                  <p class="mt-1 text-sm text-muted">{doc.body}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
