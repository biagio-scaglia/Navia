---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import Iconify from '../components/Iconify.astro'
import HeroGlobe from '../components/HeroGlobe.astro'
import RequestDemo from '../components/RequestDemo.astro'
import { docs, faq, features, limitations, refusals, services, site, stack } from '../data/site'
import torreAMare from '../assets/media/porto-di-torre-a-mare-bari-1.jpg'
import petruzzelli from '../assets/media/bari-teatro-petruzzelli.jpg'
import stradaCarmine from '../assets/media/bari-bw-2016-10-19-11-55.jpg'
import panchina from '../assets/media/panchina-mar-adriatico-puglia.jpg'

const base = import.meta.env.BASE_URL
const home = new URL(base, Astro.site).href

const schema = [
  {
    '@type': 'MobileApplication',
    '@id': `${home}#app`,
    name: site.name,
    url: home,
    description: site.description,
    applicationCategory: 'TravelApplication',
    applicationSubCategory: 'Navigazione',
    operatingSystem: `${site.minAndroid} o successivo`,
    softwareVersion: site.version,
    inLanguage: 'it-IT',
    isAccessibleForFree: true,
    license: 'https://opensource.org/license/mit',
    image: new URL(`${base}navia_logo_512.png`, Astro.site).href,
    screenshot: new URL(`${base}og-navia.jpg`, Astro.site).href,
    author: { '@id': `${home}#autore` },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    keywords: site.keywords.join(', '),
    featureList: features.map((f) => f.title),
    countriesSupported: 'IT',
  },
  {
    '@type': 'SoftwareSourceCode',
    name: `${site.name} (codice sorgente)`,
    codeRepository: site.github,
    programmingLanguage: ['Dart', 'Flutter'],
    runtimePlatform: 'Android',
    license: 'https://opensource.org/license/mit',
    author: { '@id': `${home}#autore` },
    targetProduct: { '@id': `${home}#app` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
]

const steps = [
  { label: 'Clona il repository', code: 'git clone https://github.com/biagio-scaglia/Navia.git\ncd Navia' },
  { label: 'Installa le dipendenze', code: 'flutter pub get' },
  { label: 'Avvia su un telefono o un emulatore Android', code: 'flutter run' },
]
---

<BaseLayout schema={schema}>
  <!-- Apertura: il titolo è il percorso -->
  <section class="hero" aria-labelledby="titolo">
    <HeroGlobe />
    <div class="wrap hero-body">
      <h1 id="titolo" class="hero-title">
        <span class="hero-kicker">Navia, il navigatore open source per Android</span>
        <span class="hero-line">La tua strada.</span>
        <span class="hero-route" aria-hidden="true">
          <i class="hero-origin"></i><i class="hero-track"></i><i class="hero-turn"></i>
        </span>
        <span class="hero-line hero-line-end">Non i tuoi dati.<i class="hero-dest" aria-hidden="true"></i></span>
      </h1>

      <div class="hero-foot">
        <p class="lead">
          Mappe OpenStreetMap, percorsi in auto, bici e a piedi e guida vocale in italiano.
          Senza account, senza pubblicità, senza tracciamento. Gratis e con licenza MIT.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={site.github} rel="noopener" target="_blank">
            <Iconify name="si:github" size={20} /> Vedi il codice su GitHub
          </a>
          <a class="btn btn-ghost" href={`${base}privacy/`}>
            <Icon name="shield" size={20} /> Leggi l’informativa
          </a>
        </div>
        <p class="status">
          <span class="status-dot" aria-hidden="true"></span>
          In sviluppo, versione {site.version}. Per ora si compila dal codice: l’APK pubblico non c’è ancora.
        </p>
      </div>
    </div>
  </section>

  <!-- Bari dalla strada -->
  <figure class="roadband">
    <video
      class="roadband-video"
      muted
      loop
      playsinline
      preload="none"
      poster={`${base}media/approaching-bari-114021-poster.webp`}
      width="1920"
      height="1080"
      aria-label="Si arriva a Bari in auto"
      data-autoplay
    >
      <source src={`${base}media/approaching-bari-114021.webm`} type="video/webm" />
    </video>
    <figcaption class="sign" aria-label={`Bari, ${site.bari.lat}° nord, ${site.bari.lon}° est`}>
      <span class="sign-arrow" aria-hidden="true"><Icon name="directions" size={28} /></span>
      <span class="sign-text">
        <strong>Bari</strong>
        <span class="nums">{site.bari.lat}° N, {site.bari.lon}° E</span>
      </span>
    </figcaption>
  </figure>

  <!-- Privacy -->
  <section class="block" id="privacy" aria-labelledby="privacy-titolo">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="privacy-titolo" class="h2">Un navigatore che non ti segue</h2>
        <p class="sub">
          La privacy non è un’opzione da attivare: è come l’app è costruita. Ecco cosa Navia non fa.
        </p>
      </div>
      <ul class="refusals">
        {
          refusals.map((r) => (
            <li>
              <span class="refusal-icon"><Icon name={r.icon} size={22} /></span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="wrap">
      <div class="ledger">
        <h3 class="h3">Chi riceve cosa</h3>
        <p class="sub">
          Navia non ha un server suo. Quando una funzione ha bisogno di un servizio esterno, la richiesta parte
          dal tuo telefono e contiene solo il minimo necessario.
        </p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Servizi esterni e dati ricevuti">
          <table>
            <thead>
              <tr><th scope="col">Servizio</th><th scope="col">Quando</th><th scope="col">Cosa riceve</th></tr>
            </thead>
            <tbody>
              {
                services.map((s) => (
                  <tr><th scope="row">{s.name}</th><td>{s.when}</td><td>{s.what}</td></tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="ledger-more">
          I dettagli, compresi prezzi dei carburanti, mappe e luoghi offline, sono
          nell’<a href={`${base}privacy/#servizi-esterni`}>informativa sulla privacy</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Demo: cosa esce dal telefono -->
  <section class="block night demo-block" id="prova" aria-labelledby="prova-titolo">
    <div class="wrap">
      <h2 id="prova-titolo" class="h2">Guarda cosa esce dal telefono</h2>
      <p class="sub">
        Scrivi una ricerca o scegli un mezzo: qui sotto compare la richiesta esatta che Navia invierebbe, costruita
        come nel codice dell’app.
      </p>
      <RequestDemo />
    </div>
  </section>

  <!-- Funzioni -->
  <section class="block block-tint" id="funzioni" aria-labelledby="funzioni-titolo">
    <div class="wrap">
      <h2 id="funzioni-titolo" class="h2">Cosa fa Navia {site.version}</h2>
      <p class="sub">Solo funzioni già presenti nell’app. Il resto sta nella roadmap.</p>

      <div class="features">
        {
          features.map((f) => (
            <article class="feature" id={f.id}>
              <span class="feature-icon"><Icon name={f.icon} size={26} /></span>
              <h3>{f.title}</h3>
              <p class="feature-lead">{f.lead}</p>
              <ul>
                {f.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <aside class="limits" aria-labelledby="limiti-titolo">
        <h3 id="limiti-titolo">Cosa manca ancora</h3>
        <ul>
          {limitations.map((l) => <li><Icon name="close" size={18} /><span>{l}</span></li>)}
        </ul>
        <p class="limits-more">
          Come se la cava contro Google Maps, Organic Maps e OsmAnd? Leggi il{' '}
          <a href={`${base}confronto/`}>confronto tra navigatori</a>.
        </p>
      </aside>
    </div>
  </section>

  <!-- Bari -->
  <section class="block" id="bari" aria-labelledby="bari-titolo">
    <div class="wrap bari">
      <div class="bari-copy">
        <h2 id="bari-titolo" class="h2">Nato a Bari, funziona ovunque</h2>
        <p>
          Navia è progettato e provato prima di tutto per le strade di Bari: dal Murattiano al borgo antico,
          fino al porticciolo di Torre a Mare. La mappa copre tutto il mondo; le altre città sono state
          testate meno, e le segnalazioni sono benvenute.
        </p>
        <p>
          L’interfaccia è in italiano, le categorie parlano la lingua di chi le usa (fontanelle, spiagge,
          farmacie) e i luoghi offline si scaricano per macroregione italiana.
        </p>
        <p>
          Dietro Navia c’è <a href={`${base}biagio-scaglia/`}>Biagio Scaglia</a>, sviluppatore software e UI/UX
          designer di Bari, che l’ha progettata e la sviluppa in open source.
        </p>
      </div>
      <div class="mosaic">
        <Image
          class="mosaic-a"
          src={petruzzelli}
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 34rem, 100vw"
          alt="Corso Cavour a Bari vista da una finestra del Teatro Petruzzelli"
          loading="lazy"
        />
        <Image
          class="mosaic-b"
          src={stradaCarmine}
          widths={[360, 600, 900]}
          sizes="(min-width: 960px) 16rem, 50vw"
          alt="Strada del Carmine, un vicolo di pietra nel borgo antico di Bari"
          loading="lazy"
        />
        <Image
          class="mosaic-c"
          src={panchina}
          widths={[360, 600, 900]}
          sizes="(min-width: 960px) 16rem, 50vw"
          alt="Una panchina di pietra affacciata sul mare Adriatico in Puglia"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Domande -->
  <section class="block block-tint" id="domande" aria-labelledby="domande-titolo">
    <div class="wrap split">
      <div class="split-head">
        <h2 id="domande-titolo" class="h2">Domande frequenti</h2>
        <p class="sub">
          Non trovi la risposta? Apri una discussione su{' '}
          <a href={`${site.github}/issues`} rel="noopener" target="_blank">GitHub</a>.
        </p>
      </div>
      <div class="faq">
        {
          faq.map((item, i) => (
            <details open={i === 0}>
              <summary><h3>{item.q}</h3></summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sviluppatori -->
  <section class="block" id="sviluppatori" aria-labelledby="dev-titolo">
    <div class="wrap">
      <h2 id="dev-titolo" class="h2">Per chi sviluppa</h2>
      <p class="sub">
        Codice Flutter e MapLibre con licenza MIT. Gli endpoint si impostano con
        <code>--dart-define</code>: nell’APK non c’è nessun segreto.
      </p>

      <div class="dev">
        <div>
          <h3 class="h3">Compila Navia</h3>
          <p class="dev-req">Servono Flutter 3.41, JDK 21 e l’Android SDK 36.</p>
          <ol class="steps">
            {
              steps.map((s) => (
                <li>
                  <span>{s.label}</span>
                  <pre><code>{s.code}</code></pre>
                </li>
              ))
            }
          </ol>
        </div>

        <div>
          <h3 class="h3">Tecnologie</h3>
          <dl class="stack">
            {stack.map((row) => <div><dt><Iconify name={row.icon} size={18} />{row.area}</dt><dd>{row.value}</dd></div>)}
          </dl>

          <h3 class="h3 dev-docs-title">Documentazione</h3>
          <ul class="docs">
            {
              docs.map((d) => (
                <li>
                  <a href={d.href} rel="noopener" target="_blank">
                    <strong>{d.title}</strong>
                    <span>{d.body}</span>
                    <Icon name="external_link" size={18} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Chiusura -->
  <section class="finale" aria-labelledby="finale-titolo">
    <Image
      class="finale-photo"
      src={torreAMare}
      widths={[800, 1280, 1920]}
      sizes="100vw"
      alt=""
      loading="lazy"
    />
    <div class="wrap finale-body">
      <h2 id="finale-titolo">Segui Navia fino alla prima release</h2>
      <p>Metti una stella al repository o guarda le release: l’APK arriverà lì.</p>
      <div class="actions">
        <a class="btn btn-light" href={site.github} rel="noopener" target="_blank">
          <Iconify name="si:github" size={20} /> Apri il repository
        </a>
        <a class="btn btn-ghost-light" href={site.contributing} rel="noopener" target="_blank">
          <Icon name="code" size={20} /> Contribuisci
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Il video (3 MB) parte solo quando è visibile, senza movimento ridotto e su una connessione decente:
  // con risparmio dati o rete lenta resta il poster.
  const video = document.querySelector<HTMLVideoElement>('video[data-autoplay]')
  const still = window.matchMedia('(prefers-reduced-motion: reduce)')
  const net = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection
  const slow = !!net && (net.saveData || /(^|-)(2g|3g)$/.test(net.effectiveType ?? ''))
  if (video && !slow && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !still.matches) video.play().catch(() => {})
      else video.pause()
    }, { threshold: 0.25 }).observe(video)
  }
</script>
