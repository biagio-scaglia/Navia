---
import BaseLayout from '../layouts/BaseLayout.astro'
import Cartograph from '../components/Cartograph.astro'
import InterfaceStudy from '../components/InterfaceStudy.astro'
import {
  docs,
  features,
  limitations,
  principles,
  site,
  stack,
} from '../data/site'

const base = import.meta.env.BASE_URL
---

<BaseLayout>
  <!-- Hero -->
  <section class="border-b border-rule" id="overview" aria-labelledby="hero-title">
    <div class="measure grid items-end gap-10 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:py-16">
      <div class="order-2 lg:order-1">
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">
          {site.coordinates.label} · {site.coordinates.lat} · {site.coordinates.lon} · {site.coordinates.zoom}
        </p>
        <p class="mt-8 font-display text-[clamp(3.5rem,12vw,8rem)] font-semibold leading-[0.88] tracking-[-0.05em]">
          Navia
        </p>
        <h1 id="hero-title" class="mt-6 max-w-[12ch] font-display text-[clamp(2rem,5vw,3.5rem)] font-semibold tracking-tight">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-[38ch] text-lg text-muted">
          {site.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-accent" href={site.github} rel="noreferrer" target="_blank">
            View repository
          </a>
          <a class="btn btn-ghost" href={`${base}privacy/`}>
            Privacy policy
          </a>
        </div>
        <p class="mono mt-8 text-xs text-muted">
          {site.status} · v{site.version}{site.build} · Android 7.0+ · License {site.license}
        </p>
        <p class="mt-3 max-w-[40ch] text-sm text-muted">
          No public APK release is published yet. Build from source with Flutter, or follow the repository for future releases.
        </p>
      </div>

      <div class="order-1 lg:order-2">
        <Cartograph />
      </div>
    </div>
  </section>

  <!-- Product showcase -->
  <section class="section-pad border-b border-rule" aria-labelledby="showcase-title">
    <div class="measure">
      <div class="mb-10 max-w-2xl">
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">Product</p>
        <h2 id="showcase-title" class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold">
          The map is the interface
        </h2>
        <p class="mt-4 text-lg text-muted">
          There are no marketing screenshots in the repository yet. This study
          reconstructs the shipped Italian UI—tabs, route sheet and attribution—
          so you can see how the product is organized without inventing a fake capture.
        </p>
      </div>
      <InterfaceStudy />
    </div>
  </section>

  <!-- Features -->
  <section class="section-pad border-b border-rule" id="features" aria-labelledby="features-title">
    <div class="measure">
      <div class="mb-12 max-w-2xl">
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">Features</p>
        <h2 id="features-title" class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold">
          What ships in {site.version}
        </h2>
        <p class="mt-4 text-lg text-muted">
          Every item below is implemented in the current codebase. Capabilities on the roadmap stay on the roadmap.
        </p>
      </div>

      <ol class="divide-y divide-rule border-y border-rule">
        {
          features.map((feature, index) => (
            <li class={`grid gap-6 py-10 md:grid-cols-[7rem_1fr_14rem] md:gap-8 ${index % 2 === 1 ? 'bg-sheet/60' : ''}`}>
              <p class="mono text-sm text-accent">{feature.id}</p>
              <div>
                <h3 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">{feature.title}</h3>
                <p class="mt-3 max-w-[52ch] text-muted">{feature.body}</p>
              </div>
              <p class="mono self-start text-xs leading-relaxed text-muted md:text-right">{feature.note}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 border border-rule bg-forest p-6 text-sheet sm:p-8">
        <h3 class="font-display text-2xl font-semibold">Known limits</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            limitations.map((item) => (
              <li class="border-t border-white/20 pt-3 text-sm text-white/85">{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section class="section-pad border-b border-rule" id="open-source" aria-labelledby="oss-title">
    <div class="measure grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">Open source</p>
        <h2 id="oss-title" class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold">
          Readable software
        </h2>
        <p class="mt-4 text-lg text-muted">
          Navia is MIT-licensed. Features are organized as domain, data and presentation layers. Endpoints are compile-time configuration—never secrets in the APK.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-accent" href={site.github} rel="noreferrer" target="_blank">GitHub</a>
          <a class="btn btn-ghost" href={site.contributing} rel="noreferrer" target="_blank">Contributing</a>
        </div>
      </div>

      <div class="border border-rule bg-sheet">
        <div class="border-b border-rule px-4 py-3 mono text-xs uppercase tracking-wide text-muted">
          Stack · from docs/ARCHITECTURE.md
        </div>
        <table class="w-full text-left text-sm">
          <tbody>
            {
              stack.map((row) => (
                <tr class="border-b border-rule last:border-b-0">
                  <th class="mono w-28 px-4 py-3 align-top font-medium text-muted" scope="row">
                    {row.area}
                  </th>
                  <td class="px-4 py-3 text-ink">{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section-pad border-b border-rule topo-grid" aria-labelledby="why-title">
    <div class="measure">
      <div class="max-w-3xl border border-rule bg-paper p-8 sm:p-10">
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">Why it exists</p>
        <h2 id="why-title" class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold">
          Independent navigation, plainly built
        </h2>
        <p class="mt-6 text-lg text-muted">
          Navia starts in Bari and aims to stay small: a map you can trust, routes you request, and places that come from OpenStreetMap—without an account wall or a private telemetry pipeline.
        </p>
        <ul class="mt-10 space-y-6">
          {
            principles.map((item) => (
              <li class="border-t border-rule pt-6">
                <h3 class="font-display text-xl font-semibold">{item.title}</h3>
                <p class="mt-2 max-w-[48ch] text-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Documentation -->
  <section class="section-pad" id="documentation" aria-labelledby="docs-title">
    <div class="measure">
      <div class="mb-10 max-w-2xl">
        <p class="mono text-xs tracking-[0.14em] text-muted uppercase">Documentation</p>
        <h2 id="docs-title" class="mt-3 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold">
          Source of truth in the repo
        </h2>
        <p class="mt-4 text-lg text-muted">
          Project documentation lives beside the code. These are the primary references.
        </p>
      </div>
      <ul class="grid gap-0 border-t border-rule sm:grid-cols-2">
        {
          docs.map((doc) => (
            <li class="border-b border-rule sm:odd:border-r">
              <a
                class="group block p-6 no-underline transition-colors hover:bg-sheet"
                href={doc.href}
                rel="noreferrer"
                target="_blank"
              >
                <h3 class="font-display text-2xl font-semibold group-hover:text-forest">{doc.title}</h3>
                <p class="mt-2 text-muted">{doc.body}</p>
                <p class="mono mt-4 text-xs text-accent">Open on GitHub →</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
