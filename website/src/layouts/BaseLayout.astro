---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { author, site } from '../data/site'
import overpassLatin from '@fontsource-variable/overpass/files/overpass-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  path?: string
  /** Dati strutturati schema.org aggiuntivi per la pagina. */
  schema?: Record<string, unknown>[]
  noindex?: boolean
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  schema = [],
  noindex = false,
} = Astro.props

const base = import.meta.env.BASE_URL
const abs = (p: string) => new URL(`${base}${p.replace(/^\//, '')}`.replace(/\/{2,}/g, '/'), Astro.site).href
const canonical = abs(path)
const ogImage = abs('og-navia.jpg')

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${abs('/')}#sito`,
      url: abs('/'),
      name: site.name,
      inLanguage: 'it-IT',
      description: site.description,
      publisher: { '@id': `${abs('/')}#autore` },
    },
    {
      '@type': 'Person',
      '@id': `${abs('/')}#autore`,
      name: author.name,
      givenName: 'Biagio',
      familyName: 'Scaglia',
      jobTitle: author.jobTitle,
      url: abs('biagio-scaglia/'),
      email: `mailto:${author.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: author.city,
        addressRegion: author.region,
        addressCountry: 'IT',
      },
      homeLocation: { '@type': 'Place', name: `${author.city}, ${author.region}, Italia` },
      knowsAbout: author.knowsAbout,
      knowsLanguage: ['it', 'en'],
      sameAs: [author.github, author.linkedin, author.blog, author.portfolio],
    },
    ...schema,
  ],
}
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="author" href={abs('biagio-scaglia/')} />
    <link rel="me" href={author.github} />
    <meta name="geo.region" content="IT-BA" />
    <meta name="geo.placename" content="Bari" />
    <meta name="geo.position" content={`${site.bari.lat};${site.bari.lon}`} />

    <meta name="theme-color" content="#0B63E5" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}navia_logo_512.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Il porticciolo di Torre a Mare, a Bari, sull’Adriatico" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={overpassLatin} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#contenuto" class="skip">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
